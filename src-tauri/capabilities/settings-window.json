{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-window",
  "description": "The local Settings window reads and saves fMess's settings, and Messenger's preferences through fMess's window.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "allow-get-settings",
    "allow-update-settings",
    "allow-toggle-facebook-bar",
    "allow-set-messenger-pref",
    "allow-open-messenger-preferences"
  ]
}
